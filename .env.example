GEMINI_API_KEY=
DATABASE_URL=postgresql+asyncpg://algobridge:algobridge@localhost:5432/algobridge
GEMINI_MODEL=gemini-3-flash-preview

# Incoming POST /api/v1/problems limit, per IP, per process. Positive integers.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_IPS=10000

# Export in the server environment (or set in Render); .env alone does not
# configure Uvicorn forwarding. Empty = trust no proxy headers.
# Only use verified proxy IPs/CIDRs; never *. See README deployment notes.
FORWARDED_ALLOW_IPS=
