GEMINI_API_KEY=
DATABASE_URL=postgresql+asyncpg://algobridge:algobridge@localhost:5432/algobridge
GEMINI_MODEL=gemini-3-flash-preview
# Global API generation reservations per UTC day; 0 pauses new generation.
AI_DAILY_GENERATION_LIMIT=100
# Wall-clock generation deadline; positive, at most 300 seconds.
AI_GENERATION_TIMEOUT_SECONDS=30
